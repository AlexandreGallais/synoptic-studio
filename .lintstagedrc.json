{
  "*.ts": [
    "cargo run --release -q -p format -- --write",
    "oxlint --type-check --fix --deny-warnings --no-error-on-unmatched-pattern",
    "eslint --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=0 --no-warn-ignored"
  ],
  "*.md": [
    "cargo run --release -q -p format -- --write",
    "eslint --cache --cache-location node_modules/.cache/eslint/ --fix --max-warnings=0 --no-warn-ignored"
  ],
  "*.{cjs,css,html,json,scss,toml,yaml,yml}": ["cargo run --release -q -p format -- --write"],
  "*": ["secretlint"]
}
