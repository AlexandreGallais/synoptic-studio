{
  "*.ts": [
    "cargo run --release -q -p format -- --write",
    "oxlint --type-check --fix --deny-warnings --report-unused-disable-directives-severity=error --no-error-on-unmatched-pattern",
    "cargo run --release -q -p lint -- --fix"
  ],
  "*.md": [
    "cargo run --release -q -p format -- --write",
    "cargo run --release -q -p lint -- --fix"
  ],
  "*.{cjs,css,html,json,scss,toml,yaml,yml}": ["cargo run --release -q -p format -- --write"],
  "*": ["secretlint"]
}
