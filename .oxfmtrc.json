{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "groups": [
      "builtin",
      "external",
      "internal",
      "parent",
      "sibling",
      "index",
      "type-index",
      {
        "newlinesBetween": false
      },
      "type-sibling",
      {
        "newlinesBetween": false
      },
      "type-parent",
      {
        "newlinesBetween": false
      },
      ["type-builtin", "type-external", "type-internal"]
    ],
    "ignoreCase": false,
    "newlinesBetween": true,
    "order": "asc"
  },
  "ignorePatterns": [
    "dist",
    "coverage",
    "node_modules",
    ".angular",
    "package-lock.json",
    ".idea",
    "docs/api",
    "docs/.vitepress/cache",
    "docs/.vitepress/dist",
    "src/model/font/inter-metrics.json",
    "tests/data",
    ".claude/worktrees",
    ".claude/settings.local.json",
    "docs/.vitepress/.temp",
    "target"
  ]
}
