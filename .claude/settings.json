{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(target/release/*)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "mcp__library__library_search",
      "mcp__library__library_get",
      "mcp__library__library_read",
      "Bash(npm run library *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/guard-bash",
            "args": []
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/limit-agents",
            "args": []
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/limit-agents",
            "args": []
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*curl*)",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*wget*)",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "${CLAUDE_PROJECT_DIR}/target/release/check-handback",
            "args": []
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/track-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/session-state",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/log-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/log-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$(git rev-parse --show-toplevel)/target/release/status-line\"",
    "refreshInterval": 1
  },
  "enabledMcpjsonServers": ["library"],
  "cleanupPeriodDays": 3650
}
