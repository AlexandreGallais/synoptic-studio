{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "mcp__library__library_search",
      "mcp__library__library_get",
      "mcp__library__library_read",
      "Bash(npm run library *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "guard-bash"
            ]
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "limit-agents"
            ]
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "limit-agents"
            ]
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "library-pages"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*curl*)",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "library-pages"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*wget*)",
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "library-pages"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "cargo",
            "args": [
              "run",
              "--release",
              "-q",
              "--manifest-path",
              "${CLAUDE_PROJECT_DIR}/Cargo.toml",
              "-p",
              "hooks",
              "--bin",
              "check-handback"
            ]
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--harmony-temporal",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/track-tool-call.ts"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--harmony-temporal", "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-state.ts"]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--harmony-temporal", "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-tool-call.ts"],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["--harmony-temporal", "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-tool-call.ts"],
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node --harmony-temporal \"$(git rev-parse --show-toplevel)/.claude/hooks/status-line.ts\"",
    "refreshInterval": 1
  },
  "enabledMcpjsonServers": ["library"],
  "cleanupPeriodDays": 3650
}
