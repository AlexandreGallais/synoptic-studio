{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(git switch *)",
      "Bash(gh api -X DELETE repos/AlexandreGallais/synoptic-studio/git/refs/heads/*)",
      "Bash(npm run *)",
      "Bash(target/release/activity *)",
      "Bash(target/release/backlog-status *)",
      "Bash(target/release/context-size *)",
      "Bash(target/release/dependencies outdated *)",
      "Bash(target/release/dependencies unused *)",
      "Bash(target/release/epic-check *)",
      "Bash(target/release/git-sequences commit *)",
      "Bash(target/release/git-sequences sync *)",
      "Bash(target/release/git-sequences state *)",
      "Bash(target/release/knowledge *)",
      "Bash(target/release/library *)",
      "Bash(target/release/metrics *)",
      "Bash(target/release/page *)",
      "Bash(target/release/release check *)",
      "Bash(target/release/release notes *)",
      "Bash(target/release/replace *)",
      "Bash(target/release/run-totals *)",
      "Bash(target/release/stale-binaries *)",
      "Bash(target/release/worktree-new *)",
      "Bash(npx vitest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "mcp__library__library_search",
      "mcp__library__library_get",
      "mcp__library__library_read"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/guard-bash",
            "args": [],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/limit-agents",
            "args": []
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/limit-agents",
            "args": []
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*curl*)",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(*wget*)",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/library-pages",
            "args": [],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "${CLAUDE_PROJECT_DIR}/target/release/check-handback",
            "args": []
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/track-tool-call",
            "args": [],
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/guard-bash",
            "args": [],
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/session-state",
            "args": []
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/knowledge",
            "args": ["snapshot"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/records-save",
            "args": [],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/session-report",
            "args": [],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/log-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/log-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/target/release/log-tool-call",
            "args": [],
            "async": true
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["library"],
  "cleanupPeriodDays": 3650
}
