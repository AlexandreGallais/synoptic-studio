{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "playground": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "type": "component",
          "style": "scss",
          "inlineTemplate": false,
          "inlineStyle": false,
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "type": "directive",
          "skipTests": true
        },
        "@schematics/angular:service": {
          "type": "service",
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "typeSeparator": ".",
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "typeSeparator": ".",
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [],
            "outputPath": "dist"
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "test": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "externalDependencies": ["editor"]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "playground:build:production"
            },
            "development": {
              "buildTarget": "playground:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "playground:build:test",
            "include": ["**/*.test.ts", "../testing/**/*.test.ts"],
            "isolate": true,
            "runnerConfig": "vitest-base.config.ts",
            "coverageInclude": ["src/app/**/*.ts"],
            "coverageExclude": ["**/*.test.ts", "**/index.ts"],
            "coverageReporters": ["text-summary"],
            "coverageThresholds": {
              "branches": 89,
              "functions": 100,
              "lines": 98,
              "statements": 98
            }
          },
          "configurations": {
            "timings": {
              "include": [
                "app/shared/utils/hover/helps-on-any-color.test.ts",
                "app/shared/utils/listeners/remove-listeners.test.ts",
                "app/shared/utils/mount/mount-playground.test.ts"
              ],
              "runnerConfig": "vitest-timings.config.ts"
            }
          }
        }
      }
    }
  }
}
