#!/bin/sh
set -e
. "$(dirname "$0")/tool.sh"
# Conventional Commits as commitlint checked them, then a story branch's `Refs:` or `Closes:`
# footer (`tools/git-hooks/src/message.rs`, `footer.rs`).
tool git-hooks git-hooks commit-msg "$1"
# A done commit (`Closes:`) of a story that changes a rule brings the docs it touches (EN-059).
if grep -q '^Closes:' "$1"; then tool rule-docs check-rule-docs "$1"; fi
