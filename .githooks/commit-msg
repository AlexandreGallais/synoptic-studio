#!/bin/sh
set -e
. "$(dirname "$0")/tool.sh"
# Conventional Commits as commitlint checked them, then a story branch's `Refs:` or `Closes:`
# footer (`tools/git-hooks/src/message.rs`, `footer.rs`). No `done` commit is checked any more:
# a story's status and rules live in the records (EN-154).
tool git-hooks git-hooks commit-msg "$1"
