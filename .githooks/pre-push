#!/bin/sh
set -e
. "$(dirname "$0")/tool.sh"
PATH="node_modules/.bin:$PATH"
tool shared-files refuse-shared-files
validate-branch-name
npm run check:all
# The golden file of a refactor (ADR-0049, EN-055): when one is written, a drift of results fails the push.
if [ -f "$(git rev-parse --path-format=absolute --git-common-dir)/metrics/golden.json" ]; then npm run golden:check; fi
