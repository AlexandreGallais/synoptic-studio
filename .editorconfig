# EditorConfig — https://editorconfig.org
# Single source of the shared editor settings. oxfmt also reads max_line_length; `.oxfmtrc.json`
# repeats it as printWidth, as its migration from Prettier asks (EN-073).
# See docs/conventions/formatting.md.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
