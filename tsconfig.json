{
  // Policy: the linters (oxlint, the project's Rust linter) carry every rule they can check. Only
  // the options the compiler alone can guarantee (type system, module resolution) are here. See
  // the records' conventions, area typescript, and ADR-0075.
  "compilerOptions": {
    // Target and modules
    "target": "es2025",
    "lib": ["es2025", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "resolveJsonModule": true,
    // Node.js runs `scripts/default-font-metrics.ts` as it is (type stripping): relative imports name the .ts file.
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],

    // Type system: out of the linters' reach
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,

    // Left to oxlint, off by default here: noUnusedLocals and noUnusedParameters (no-unused-vars),
    // noFallthroughCasesInSwitch (no-fallthrough), allowUnreachableCode (no-unreachable).

    // Output: checking only; tools/declarations writes the library's .d.ts (EN-091)
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "playground", "docs/.vitepress/**/*.ts", "scripts", "tests", "*.ts"]
}
