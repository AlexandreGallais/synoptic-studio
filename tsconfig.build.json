{
  // Emits the library declarations (dist/types). The JavaScript is produced by Vite.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
