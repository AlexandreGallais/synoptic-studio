{
  "name": "editor",
  "version": "0.8.2",
  "private": true,
  "description": "Integer, orthogonal, path-only SVG editing library for synoptic-view symbols.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreGallais/synoptic-studio.git"
  },
  "homepage": "https://alexandregallais.github.io/synoptic-studio/",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run deps:audit && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "prettier --write . && eslint --fix .",
    "typecheck": "tsc --noEmit",
    "deps:audit": "npm audit --audit-level=low",
    "deps:outdated": "ncu",
    "deps:tools": "node scripts/tool-versions.ts",
    "check": "npm run format:check && npm run lint && npm run lint:secrets && npm run typecheck && npm run test && npm run deps:audit",
    "check:all": "npm run check && npm run deps:outdated && npm run deps:tools && npm run docs:build && npm run playground:build",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "lint:secrets": "secretlint \"**/*\"",
    "playground:build": "vite build --mode playground"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@fast-check/vitest": "0.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "@typescript-eslint/rule-tester": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.2.4",
    "eslint-plugin-unicorn": "77.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.6",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "validate-branch-name": "1.3.2",
    "vite": "8.3.4",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "katex": "^0.19.0"
  },
  "lint-staged": {
    "*.{ts,md}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,html,css,scss,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  },
  "validate-branch-name": {
    "pattern": "^(main|feature/f[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*|(feat|fix|docs|refactor|test|chore|build|ci|perf|style|revert)/[a-z0-9]+(-[a-z0-9]+)*|dependabot/.+|release-please--.+)$",
    "errorMsg": "Branch name must be `main`, `feature/f01-<kebab-case-topic>` or `<type>/<kebab-case-topic>` (docs/tooling/git-workflow.md)."
  }
}
