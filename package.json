{
  "name": "editor",
  "version": "0.1.0",
  "private": true,
  "description": "Integer, orthogonal, path-only SVG editing library for synoptic-view symbols.",
  "license": "Apache-2.0",
  "homepage": "https://alexandregallais.github.io/synoptic-studio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexandreGallais/synoptic-studio.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run deps:audit && vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "fix": "prettier --write . && eslint --cache --cache-location node_modules/.cache/eslint/ --fix .",
    "check": "npm run format:check && npm run lint && npm run lint:secrets && npm run typecheck && npm run test && npm run deps:audit && npm run deps:unused",
    "check:all": "node --harmony-temporal scripts/check-all.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "lint:secrets": "secretlint \"**/*\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:audit": "npm audit --audit-level=low",
    "deps:outdated": "ncu",
    "deps:tools": "node scripts/tool-versions.ts",
    "deps:unused": "knip",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "playground:build": "vite build --mode playground",
    "metrics": "node --harmony-temporal scripts/metrics-report.ts",
    "metrics:session": "node --harmony-temporal scripts/session-report.ts",
    "library": "node --harmony-temporal --no-warnings=ExperimentalWarning scripts/library-cli.ts",
    "prepare": "husky",
    "branches:clean": "node --harmony-temporal --no-warnings=ExperimentalWarning scripts/branches-clean.ts",
    "records:save": "node --harmony-temporal --no-warnings=ExperimentalWarning scripts/records-save.ts",
    "replace": "node scripts/replace-text.ts",
    "golden:write": "vitest run tests/golden-results.test.ts --mode golden-write",
    "golden:check": "vitest run tests/golden-results.test.ts --mode golden-check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@eslint/js": "10.0.1",
    "@eslint/markdown": "8.0.3",
    "@fast-check/vitest": "0.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.5",
    "@typescript-eslint/rule-tester": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-functional": "10.0.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.3.1",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.1",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "knip": "6.40.0",
    "lint-staged": "17.6.0",
    "mermaid": "12.1.0",
    "npm-check-updates": "23.1.1",
    "prettier": "3.9.10",
    "secretlint": "13.0.7",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "validate-branch-name": "1.3.2",
    "vite": "8.3.4",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "katex": "^0.19.0"
  }
}
