{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".claude/hooks/{guard-bash,session-state,log-tool-call,track-tool-call,status-line}.ts",
    "scripts/{branches-clean,tool-versions,metrics-report,session-report,library-cli,library-mcp,records-save,watch-task,default-font-metrics}.ts",
    "docs/.vitepress/config.ts",
    "docs/.vitepress/theme/index.ts",
    ".ncurc.cjs"
  ],
  "project": [
    "*.ts",
    ".claude/hooks/**/*.ts",
    "docs/.vitepress/**/*.ts",
    "eslint/**/*.ts",
    "playground/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreDependencies": ["@secretlint/secretlint-rule-preset-recommend", "fast-check"]
}
