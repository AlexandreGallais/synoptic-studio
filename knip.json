{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/{tool-versions,default-font-metrics}.ts",
    "docs/.vitepress/config.ts",
    "docs/.vitepress/theme/index.ts",
    ".ncurc.cjs"
  ],
  "project": [
    "*.ts",
    "docs/.vitepress/**/*.ts",
    "playground/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts"
  ],
  "ignoreDependencies": [
    "@secretlint/secretlint-rule-preset-recommend",
    "fast-check",
    "oxfmt",
    "secretlint"
  ]
}
